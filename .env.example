# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Leave the base URL empty and point everything at the Vite dev proxy, which
# forwards /api -> http://127.0.0.1:8000 (see vite.config.js). No CORS setup
# needed on either side.
# VITE_API_BASE_URL=api

# Where the dev proxy forwards to. Only read by vite.config.js.
VITE_DEV_API_TARGET=https://h38aqomaxk.execute-api.us-east-1.amazonaws.com/

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# Point straight at the deployed API and remove the proxy from the equation.
# The backend's ALLOWED_DOMAIN must then match the origin serving this app.
VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod

# Client-side request timeout in ms. Keep below API Gateway's 29s ceiling.
VITE_API_TIMEOUT_MS=30000

# Page <title> and header <h1> text. scripts/build-apps.sh sets this per app
# from scripts/apps.json when building all 7 at once; a plain `npm run dev`
# / `npm run build` falls back to whatever's in .env.development / .env.production.
VITE_APP_TITLE=Safety View - COSMOS
