# AWS account that owns the QuickSight resources.
AWS_ACCOUNT_ID=123456789012

# AWS region QuickSight is provisioned in (also read by boto3 if AWS_DEFAULT_REGION isn't set elsewhere).
AWS_REGION=us-east-1

# ARN of the QuickSight user embed URLs are generated for. This user's ROLE
# (Reader/Author/Admin) determines what the embedded session can do — see
# docs/quicksight-console-embedding/README.md. Must be an Author (or Admin)
# for /console-embed-url to be useful; Dashboard/reader embedding tolerates
# a Reader.
QUICKSIGHT_USER_ARN=arn:aws:quicksight:us-east-1:123456789012:user/default/console-author

# Dashboard the reader-mode embed URL points at, and the default landing
# point (/dashboards/<id>) for the console-mode embed URL too.
DASHBOARD_ID=00000000-0000-0000-0000-000000000000

# Origin(s) allowed to frame the embed URL and to call this API (CORS).
# Comma-separated for more than one, e.g. a local dev origin plus prod.
ALLOWED_DOMAIN=http://localhost:5173

# Minutes an embed URL / console session stays valid before a fresh one is needed.
SESSION_LIFETIME_MINUTES=100
